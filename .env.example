# Copy to .env to override docker-compose defaults. Every value below has a working dev default.

# Shared secrets — CHANGE these for anything other than local dev.
JWT_SECRET=dev-jwt-secret-change-me-please
INTERNAL_TOKEN=dev-internal-token-change-me

# Set to false for load tests (all virtual users share one IP).
RATE_LIMIT_ENABLED=true

# Payments: "mock" works out of the box. For Razorpay test mode, create test keys in the
# Razorpay dashboard and point a webhook at  <public-url>/api/payments/webhooks/razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
